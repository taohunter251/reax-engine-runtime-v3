+    _launch("ffs_pvx", P, B, extra=v)
+    return v
+
+
+def _eq(a, b) -> bool:
+    vw = torch.int32 if a.dtype == torch.float32 else torch.int16
+    return a.shape == b.shape and torch.equal(a.contiguous().view(vw), b.contiguous().view(vw))
